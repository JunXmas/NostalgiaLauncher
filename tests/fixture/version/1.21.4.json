   "${auth_player_name}",
   "--version",
   "${version_name}",
   "--gameDir",
   "${game_directory}",
   "--assetsDir",
   "${assets_root}",
   "--assetIndex",
   "${assets_index_name}",
   "--uuid",
   "${auth_uuid}",
   "--accessToken",
   "${auth_access_token}",
